{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@glaze/core/backend": ["../src/glaze-compat/backend/index.ts"],
      "@glaze/core/oauth": ["../src/glaze-compat/oauth/index.ts"],
      "@glaze/core/ipc": ["../src/glaze-compat/ipc/index.ts"],
      "@glaze/core/preload": ["../src/glaze-compat/preload/index.ts"],
      "@glaze/core/components": ["../src/glaze-compat/components/index.ts"],
      "@glaze/core/hooks": ["../src/glaze-compat/hooks/index.ts"],
      "@glaze/core/utils": ["../src/glaze-compat/utils/index.ts"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
