# Dependencies
node_modules/

# Build outputs (electron-vite fallback: plain Vite + lib-mode builds)
out/
build/
dist/
.devserverhost

# Agent context (auto-generated, not worth versioning)
.glaze_memory/

# App icons. app-icon.icns is tracked (electron-builder needs it to build
# from a fresh clone); app-icon.png is a large source/reference export, not
# needed at build time, and stays ignored.
app-icon.png

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Glaze agent temporary files
tmp/*

# Local agent memory (not part of app source)
.remember/
